# 复制为 .env 后填写（.env 已被 .gitignore 忽略）。本地运行前执行：set -a; source .env; set +a
# 所有密钥只从环境变量读取，不要写入代码或提交到仓库。

# Anthropic API Key（必填）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 可选：覆盖 Anthropic API 地址（例如企业代理或网关）。默认 https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 飞书自定义机器人 Webhook 地址（非 dry-run 时必填）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 可选：若机器人开启了“签名校验”，填写其密钥；未开启则留空
FEISHU_WEBHOOK_SECRET=

# 可选：覆盖 config.yaml 中的模型名
# SCORE_MODEL=claude-haiku-5-5
# READ_MODEL=claude-sonnet-5-5

# 可选：每次运行的 token 预算（输入+输出），超出后跳过精读
# DAILY_TOKEN_BUDGET=300000
